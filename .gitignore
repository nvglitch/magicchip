# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large files
*.psd
*.pdf

# Published certificates and supporting reports used by the website downloads.
!/public/assets/certificates/mcipc8-ce-emc-certificate.pdf
!/public/assets/certificates/mcipc8-ce-emc-report.pdf
!/public/assets/certificates/mcipc8-ce-lvd-certificate.pdf
!/public/assets/certificates/mcipc8-ce-lvd-report.pdf
!/public/assets/certificates/mcipc8-fcc-sdoc-certificate.pdf
!/public/assets/certificates/mcipc8-fcc-sdoc-report.pdf
!/public/assets/certificates/mcipc8-rohs-certificate.pdf
!/public/assets/certificates/mcipc8-rohs-report.pdf
